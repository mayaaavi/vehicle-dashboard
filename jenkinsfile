pipeline {
    agent any

    environment {
        IMAGE_NAME = 'ghcr.io/mayaaavi/vehicle-dashboard'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Setup') {
            steps {
                sh '''
                    python3 --version
                    pip3 install -r requirements.txt
                '''
            }
        }

        stage('Generate Image Tag') {
            steps {
                script {
                    env.IMAGE_TAG = sh(
                        script: 'git rev-parse --short=7 HEAD',
                        returnStdout: true
                    ).trim()
                }

                echo "Image tag: ${IMAGE_TAG}"
            }
        }

        stage('Build Docker Image') {
            steps {
                sh '''
                    docker build \
                    -t ${IMAGE_NAME}:${IMAGE_TAG} .
                '''
            }
        }

        stage('Push Docker Image') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'ghcr-credentials',
                        usernameVariable: 'GHCR_USER',
                        passwordVariable: 'GHCR_TOKEN'
                    )
                ]) {
                    sh '''
                        echo "$GHCR_TOKEN" | \
                        docker login ghcr.io \
                        -u "$GHCR_USER" \
                        --password-stdin

                        docker push ${IMAGE_NAME}:${IMAGE_TAG}
                    '''
                }
            }
        }
    }
}
stage('Update Helm Image Tag') {
    steps {
        sh '''
            sed -i "s/tag: .*/tag: \\"${IMAGE_TAG}\\"/" \
            helm/vehicle-dashboard/values.yaml

            echo "Updated Helm values:"
            grep -A3 "^image:" helm/vehicle-dashboard/values.yaml
        '''
    }
}

stage('Commit Helm Update') {
    steps {
        withCredentials([
            gitUsernamePassword(
                credentialsId: 'ghcr-credentials',
                gitToolName: 'Default'
            )
        ]) {
            sh '''
                git config user.name "jenkins"
                git config user.email "jenkins@localhost"

                git add helm/vehicle-dashboard/values.yaml

                git commit -m "Update image tag to ${IMAGE_TAG}"

                git push origin HEAD:main
            '''
        }
    }
}
